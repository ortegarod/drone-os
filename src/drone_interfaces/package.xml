<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>drone_interfaces</name>
  <version>0.0.0</version>
  <description>Custom message and service interfaces for DroneOS</description>
  <maintainer email="ortegarod@users.noreply.github.com">DroneOS</maintainer>
  <url type="website">https://droneos.dev</url>
  <url type="bugtracker">https://github.com/ortegarod/drone-os/issues</url>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <depend>builtin_interfaces</depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package> 