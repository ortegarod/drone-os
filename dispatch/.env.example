# Dispatch bridge settings (all optional)

# Dispatch service URL
DISPATCH_API_URL=http://localhost:8081

# Bridge control API port (localhost)
DISPATCH_BRIDGE_PORT=8082

# OpenClaw agent that dispatches (one session per incident)
DISPATCH_AGENT=main

# Poll interval (seconds)
DISPATCH_POLL_INTERVAL=2

# OpenClaw gateway (read from ~/.openclaw/openclaw.json if not set)
# OPENCLAW_GATEWAY_WS_URL=ws://127.0.0.1:18789
# OPENCLAW_GATEWAY_TOKEN=***
