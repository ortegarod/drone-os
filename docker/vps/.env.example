# Copy to docker/vps/.env (not in git) and fill in.
# Host running rosbridge (:9090) and web_video_server (:8080): the sim host for SITL, later the drone.
SIM_HOST=100.x.y.z
# Operators named here are admins (comma-separated). Default: admin
FLEET_API_ADMINS=
# Dev only (Tailscale): log the browser in as this operator, no key screen. Empty = key screen.
AUTO_LOGIN_OPERATOR=
